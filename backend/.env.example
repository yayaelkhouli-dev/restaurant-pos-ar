# Copy this file to `.env` and adjust. `.env` is never committed.

# --- Database ---
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=change-me
DB_NAME=pos_system
DB_SSLMODE=disable

# --- API server ---
PORT=8080
GIN_MODE=release

# --- Auth ---
# Leave this empty for a normal install: the server generates a random signing
# key on first boot and stores it in backend/jwt.key (which is gitignored).
# Set it only when you run several backend instances that must share sessions.
# JWT_SECRET=
