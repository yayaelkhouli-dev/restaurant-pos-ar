# Copy this file to `.env`. `.env` is never committed.

# Keep this RELATIVE. Every terminal on the LAN then reaches the API through the
# Vite server's proxy, which forwards to the backend on the server machine.
# An absolute http://localhost:8080/... would make each terminal call ITSELF.
VITE_API_URL=/api/v1

# Where the Vite proxy forwards /api requests. Change only if the backend runs
# on a different host than the frontend.
# VITE_PROXY_TARGET=http://localhost:8080
